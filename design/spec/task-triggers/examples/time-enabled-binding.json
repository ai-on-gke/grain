{
  "api_version": "grain.trigger/v1",
  "id": "daily-review",
  "version": 1,
  "provider": {
    "id": "builtin:time",
    "release": "sha256:0f949819259c549404e0c9bd49fbdaf575781a6e454b766986eb6fc1212baef6",
    "source_type": "calendar",
    "version": "1",
    "schema_digest": "sha256:ca3e8219701115a27d70eefea6f6d7fc845a770ff6e83988dabf00f1379d1b7e",
    "config_revision": "1"
  },
  "source": {
    "type": "calendar",
    "recurrence": {
      "kind": "daily",
      "time_of_day_minutes": 540
    },
    "time_zone": "UTC",
    "dst": "skip_gap_first_fold",
    "calendar_version": "tzdb:2026b"
  },
  "event_kind": "time.occurrence",
  "kind_version": "1",
  "mode": "occurrence",
  "filter": {
    "all": []
  },
  "template": {
    "id": "repo:template:ai-on-gke:grain:daily-review",
    "revision": "sha256:db34db4f1626641450148ae286eaf7dd12924c540a5dc28fdc518f8813221ad5",
    "tracking": "pinned"
  },
  "parameters": {
    "date": {
      "from": "/extensions/local_date",
      "type": "string",
      "max_bytes": 10
    }
  },
  "target": {
    "repository": "ai-on-gke/grain",
    "base": "main"
  },
  "identity": {
    "owner": "user:review-owner",
    "service": "service:trigger-filer"
  },
  "permissions": {
    "read_repositories": [
      "ai-on-gke/grain"
    ],
    "task_capabilities": [],
    "actions": [
      "task.create_from_trigger"
    ]
  },
  "policy": {
    "admission": "standard",
    "approval": "proposed",
    "approval_authorization": null,
    "auto_merge": false,
    "auto_approve_proposals": false
  },
  "repeat": {
    "policy": "new",
    "key_fields": [
      "/source"
    ],
    "on_head_change": "ignore",
    "active_limit": 1
  },
  "delivery": {
    "initial": "baseline",
    "enable": "future_only",
    "catch_up": "hold",
    "max_age_seconds": 86400,
    "debounce_seconds": 0,
    "batch_max": 1
  },
  "state": "enabled",
  "quotas": {
    "matches_per_hour": 20,
    "tasks_per_day": 2,
    "queue_size": 20,
    "concurrent_tasks": 1,
    "fanout_per_event": 1,
    "cost_units_per_day": 100
  },
  "loops": {
    "automation": "allow_bounded",
    "max_depth": 3,
    "max_chain_tasks": 10
  }
}
