{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grain:task-triggers:wire:v1",
  "title": "Proposed Grain trigger bindings",
  "description": "Documentation schema. Cross-field authority, byte limits, source scope and provider schemas remain normative in TTS-1 through TTS-15. Additional providers require registered schemas and reviewed version evolution; this file defines the two concrete examples only.",
  "$ref": "#/$defs/binding",
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "release",
        "source_type",
        "version",
        "schema_digest",
        "config_revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "schema_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "config_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "recurrence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "time_of_day_minutes"
          ],
          "properties": {
            "kind": {
              "enum": [
                "daily"
              ]
            },
            "time_of_day_minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "weekday",
            "time_of_day_minutes"
          ],
          "properties": {
            "kind": {
              "enum": [
                "weekly"
              ]
            },
            "weekday": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "time_of_day_minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "day_of_month",
            "time_of_day_minutes"
          ],
          "properties": {
            "kind": {
              "enum": [
                "monthly"
              ]
            },
            "day_of_month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            "time_of_day_minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "minutes"
          ],
          "properties": {
            "kind": {
              "enum": [
                "every_n_minutes"
              ]
            },
            "minutes": {
              "type": "integer",
              "minimum": 10,
              "maximum": 527040
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "hours"
          ],
          "properties": {
            "kind": {
              "enum": [
                "every_n_hours"
              ]
            },
            "hours": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8784
            }
          }
        }
      ]
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "recurrence",
        "time_zone",
        "dst",
        "calendar_version"
      ],
      "properties": {
        "type": {
          "enum": [
            "calendar"
          ]
        },
        "recurrence": {
          "$ref": "#/$defs/recurrence"
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "dst": {
          "enum": [
            "skip_gap_first_fold",
            "legacy_go_time_date"
          ]
        },
        "calendar_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "github_review_requests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "host",
        "installation",
        "repository_id",
        "repository",
        "recipient"
      ],
      "properties": {
        "type": {
          "enum": [
            "github_review_requests"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "installation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "recipient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "user",
                "team"
              ]
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "op",
                  "value"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/",
                    "maxLength": 512
                  },
                  "op": {
                    "enum": [
                      "eq"
                    ]
                  },
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "op",
                  "value"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/",
                    "maxLength": 512
                  },
                  "op": {
                    "enum": [
                      "in"
                    ]
                  },
                  "value": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "op",
                  "value"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/",
                    "maxLength": 512
                  },
                  "op": {
                    "enum": [
                      "exists"
                    ]
                  },
                  "value": {
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "minItems": 0,
          "maxItems": 32
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "type",
        "max_bytes"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 512
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean"
          ]
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "id",
        "version",
        "provider",
        "source",
        "event_kind",
        "kind_version",
        "mode",
        "filter",
        "template",
        "parameters",
        "target",
        "identity",
        "permissions",
        "policy",
        "repeat",
        "delivery",
        "state",
        "quotas",
        "loops"
      ],
      "properties": {
        "api_version": {
          "enum": [
            "grain.trigger/v1"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/calendar"
            },
            {
              "$ref": "#/$defs/github_review_requests"
            }
          ]
        },
        "event_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "mode": {
          "enum": [
            "occurrence",
            "state_edge"
          ]
        },
        "filter": {
          "$ref": "#/$defs/filter"
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "tracking"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "tracking": {
              "enum": [
                "pinned",
                "track_compatible"
              ]
            }
          }
        },
        "parameters": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mapping"
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "base"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "base": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "service"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "service": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read_repositories",
            "task_capabilities",
            "actions"
          ],
          "properties": {
            "read_repositories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "minItems": 0,
              "maxItems": 32
            },
            "task_capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "minItems": 0,
              "maxItems": 32
            },
            "actions": {
              "type": "array",
              "items": {
                "enum": [
                  "task.create_from_trigger",
                  "task.coalesce_trigger"
                ]
              },
              "minItems": 1,
              "maxItems": 2
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "admission",
            "approval",
            "approval_authorization",
            "auto_merge",
            "auto_approve_proposals"
          ],
          "properties": {
            "admission": {
              "enum": [
                "standard",
                "bypass",
                "durable"
              ]
            },
            "approval": {
              "enum": [
                "proposed",
                "standing"
              ]
            },
            "approval_authorization": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512
            },
            "auto_merge": {
              "type": "boolean"
            },
            "auto_approve_proposals": {
              "type": "boolean"
            }
          }
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "key_fields",
            "on_head_change",
            "active_limit"
          ],
          "properties": {
            "policy": {
              "enum": [
                "new",
                "coalesce",
                "ignore"
              ]
            },
            "key_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/",
                "maxLength": 512
              },
              "minItems": 1,
              "maxItems": 8
            },
            "on_head_change": {
              "enum": [
                "ignore",
                "new_request_only",
                "new"
              ]
            },
            "active_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial",
            "enable",
            "catch_up",
            "max_age_seconds",
            "debounce_seconds",
            "batch_max"
          ],
          "properties": {
            "initial": {
              "enum": [
                "baseline",
                "emit_current"
              ]
            },
            "enable": {
              "enum": [
                "future_only"
              ]
            },
            "catch_up": {
              "enum": [
                "hold",
                "skip",
                "one"
              ]
            },
            "max_age_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2592000
            },
            "debounce_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            },
            "batch_max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "state": {
          "enum": [
            "enabled",
            "paused"
          ]
        },
        "quotas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "matches_per_hour",
            "tasks_per_day",
            "queue_size",
            "concurrent_tasks",
            "fanout_per_event",
            "cost_units_per_day"
          ],
          "properties": {
            "matches_per_hour": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "tasks_per_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "queue_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "concurrent_tasks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "fanout_per_event": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "cost_units_per_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "loops": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "automation",
            "max_depth",
            "max_chain_tasks"
          ],
          "properties": {
            "automation": {
              "enum": [
                "hold",
                "allow_bounded"
              ]
            },
            "max_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "max_chain_tasks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "properties": {
                  "type": {
                    "const": "calendar"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "event_kind": {
                "const": "time.occurrence"
              },
              "mode": {
                "const": "occurrence"
              },
              "provider": {
                "properties": {
                  "id": {
                    "const": "builtin:time"
                  },
                  "source_type": {
                    "const": "calendar"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "properties": {
                  "type": {
                    "const": "github_review_requests"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "event_kind": {
                "const": "github.pull_request.review_requested"
              },
              "mode": {
                "const": "occurrence"
              },
              "provider": {
                "properties": {
                  "source_type": {
                    "const": "github_review_requests"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "properties": {
                  "approval": {
                    "const": "proposed"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "policy": {
                "properties": {
                  "approval_authorization": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "policy": {
                "properties": {
                  "approval_authorization": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "provider",
        "provider_version",
        "source",
        "event_id",
        "kind",
        "kind_version",
        "occurred_at",
        "received_at",
        "resource",
        "provenance",
        "extensions",
        "payload"
      ],
      "properties": {
        "protocol_version": {
          "enum": [
            "1.0"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "provider_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "occurred_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "resource": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id",
                "revision"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "revision": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transport",
            "authentication_ref",
            "actor",
            "actor_kind",
            "installation",
            "origin_task",
            "origin_action",
            "causation_id",
            "chain_id",
            "depth"
          ],
          "properties": {
            "transport": {
              "enum": [
                "webhook",
                "poll",
                "stream",
                "time",
                "internal"
              ]
            },
            "authentication_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "actor": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512
            },
            "actor_kind": {
              "enum": [
                "human",
                "automation",
                "unknown"
              ]
            },
            "installation": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512
            },
            "origin_task": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512
            },
            "origin_action": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512
            },
            "causation_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512
            },
            "chain_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512
            },
            "depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16
            }
          }
        },
        "extensions": {
          "type": "object"
        },
        "payload": {
          "type": "object"
        }
      },
      "description": "Validate extensions separately against the pinned kind schema. Enforce encoded byte/depth limits and authenticated provenance in TTS-3; JSON Schema maxLength alone is not a UTF-8 byte bound."
    },
    "github_review_requested_extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "number",
        "head",
        "recipient_kind",
        "recipient_id",
        "request_epoch",
        "url"
      ],
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "head": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "recipient_kind": {
          "enum": [
            "user",
            "team"
          ]
        },
        "recipient_id": {
          "type": "integer",
          "minimum": 1
        },
        "request_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "time_occurrence_extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduled_at",
        "local_date",
        "cadence_epoch",
        "time_zone",
        "covered_through"
      ],
      "properties": {
