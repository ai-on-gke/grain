        "evaluation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "gate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contract_revision": {
          "type": "integer",
          "minimum": 0
        },
        "authority_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_revision": {
          "type": "integer",
          "minimum": 0
        },
        "expected_state_revision": {
          "type": "integer",
          "minimum": 0
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permission_revision": {
          "type": "integer",
          "minimum": 0
        },
        "read_scope_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\r\\n]*$"
        },
        "kind": {
          "const": "needs_data"
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/page_request"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "continuation_state": {
          "description": "Version 1 transient JSON; <=16 KiB/depth 16, no credentials. Echo unchanged in next request."
        }
      }
    },
    "response": {
      "oneOf": [
        {
          "$ref": "#/$defs/final_response"
        },
        {
          "$ref": "#/$defs/needs_data"
        }
      ]
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "declaration",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "declaration": {
          "$ref": "#/$defs/discovery"
        },
        "steps": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "message"
                ],
                "properties": {
                  "type": {
                    "const": "call"
                  },
                  "message": {
                    "$ref": "#/$defs/request"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "message"
                ],
                "properties": {
                  "type": {
                    "const": "reply"
                  },
                  "message": {
                    "$ref": "#/$defs/response"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "message"
                ],
                "properties": {
                  "type": {
                    "const": "controller_error"
                  },
                  "message": {
                    "$ref": "#/$defs/final_response"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "description"
                ],
                "properties": {
                  "type": {
                    "const": "event"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 40
        }
      }
    },
    "read_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "retryable",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "unauthorized",
            "unsupported_version",
            "resource_limit",
            "request_loop",
            "unavailable"
          ]
        },
        "retryable": {
          "const": false
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}
