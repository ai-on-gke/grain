            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 1,
          "maxItems": 32
        },
        "required": {
          "type": "boolean"
        },
        "prefetch": {
          "type": "boolean"
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "snapshot_version",
        "transport",
        "continuation_version",
        "evidence_replay_safe",
        "inputs",
        "record_schemas"
      ],
      "properties": {
        "protocol_version": {
          "const": "2.0"
        },
        "snapshot_version": {
          "const": "2"
        },
        "transport": {
          "const": "grain_rounds"
        },
        "continuation_version": {
          "const": "1"
        },
        "evidence_replay_safe": {
          "type": "boolean"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_domain"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "record_schemas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "schema_digest"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "schema_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "reference_id",
        "code",
        "reason"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "reference_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "code": {
          "enum": [
            "unavailable",
            "unauthorized",
            "unsupported_version",
            "resource_limit",
            "reference_expired"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "snapshot_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "kind",
        "record_kind",
        "schema_digest",
        "version",
        "page_count",
        "record_count",
        "expires_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "const": "snapshot_page"
        },
        "record_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "record_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6400
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "delivery": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "status",
            "page"
          ],
          "properties": {
            "request": {
              "$ref": "#/$defs/page_request"
            },
            "status": {
              "const": "ok"
            },
            "page": {
              "$ref": "#/$defs/page"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "status",
            "error"
          ],
          "properties": {
            "request": {
              "$ref": "#/$defs/page_request"
            },
            "status": {
              "const": "unavailable"
            },
            "error": {
              "$ref": "#/$defs/read_error"
            }
          }
        }
      ]
    },
    "final_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "evaluation_id",
        "gate_id",
        "snapshot_id",
        "contract_revision",
        "authority_epoch",
        "policy_revision",
        "evidence_revision",
        "expected_state_revision",
        "status",
        "summary",
        "evidence",
        "gate_state",
        "blockers",
        "work",
        "action_requests",
        "waits",
        "buttons",
        "kind",
        "round",
        "request_digest",
        "bundle_id",
        "permission_revision",
        "read_scope_digest"
      ],
      "properties": {
        "protocol_version": {
          "const": "2.0"
        },
        "evaluation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "gate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contract_revision": {
          "type": "integer",
          "minimum": 0
        },
        "authority_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_revision": {
          "type": "integer",
          "minimum": 0
        },
        "expected_state_revision": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "met",
            "unmet",
            "pending",
            "error",
            "unknown"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\r\\n]*$"
        },
        "human_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "agent_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "maxItems": 128
        },
        "gate_state": {
          "description": "Bounded opaque JSON; byte/depth limits and secret exclusion are normative in MGS-2."
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          },
          "maxItems": 64
        },
        "work": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/work"
          },
          "maxItems": 32
        },
        "action_requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action_request"
          },
          "maxItems": 32
        },
        "waits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wait"
          },
          "maxItems": 64
        },
        "buttons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/button"
          },
          "maxItems": 16
        },
        "in_flight": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "maxItems": 32
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "kind": {
          "const": "final"
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permission_revision": {
          "type": "integer",
          "minimum": 0
        },
        "read_scope_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "met"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              },
              "blockers": {
                "maxItems": 0
              },
              "work": {
                "maxItems": 0
              },
              "action_requests": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "properties": {
              "work": {
                "maxItems": 0
              },
              "action_requests": {
                "maxItems": 0
              },
              "buttons": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "error"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "waits": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "in_flight"
                ],
                "properties": {
                  "in_flight": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "needs_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "evaluation_id",
        "gate_id",
        "snapshot_id",
        "contract_revision",
        "authority_epoch",
        "policy_revision",
        "evidence_revision",
        "expected_state_revision",
