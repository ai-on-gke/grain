# Granulefile: Declarative multi-stage microVM build for Grain sandbox guest
#
# The base is pinned by digest as well as by tag, for the reason the main
# Dockerfile gives above its own ARGs: a tag is a name its registry can
# repoint, and the digest is what is fetched. `granule granulefile build`
# hands this FROM to docker unchanged, so the digest is honoured. It is
# the same value as the Dockerfile's RUNTIME_IMAGE and
# Dockerfile.k8s-sandbox's BASE_IMAGE -- bump all of them together
# (TestEveryBaseImageIsPinnedByDigest checks they agree).
ARG BASE_IMAGE=debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
ARG GO_VERSION=1.26.10
ARG GO_IMAGE=golang
ARG GO_IMAGE_DIGEST=sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af
ARG NODE_VERSION=20.19.0
ARG KIND_VERSION=v0.32.0
ARG ACT_VERSION=v0.2.89
ARG ACTIONLINT_VERSION=1.7.12

FROM ${GO_IMAGE}:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS grain_connect_builder
ENV GOTOOLCHAIN=local
COPY cmd/grain-connect/main.go /tmp/grain-connect/main.go
RUN CGO_ENABLED=0 go build -o /out/grain-connect /tmp/grain-connect/main.go \
    && chmod 0755 /out/grain-connect
# The sandbox's own grain (cmd/grain-sandbox: `grain host-script`), built
# from standard-library packages alone: a go.mod naming the module is all
# it needs, so the repository's own (and every go.mod bump) stays out of
# this image's inputs (scripts/granule/guest-inputs.sh).
COPY pkg/hostscriptcli /src/pkg/hostscriptcli
COPY cmd/grain-sandbox /src/cmd/grain-sandbox
RUN cd /src && printf 'module github.com/bwsalmon/grain\n\ngo 1.26\n' > go.mod \
    && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/grain ./cmd/grain-sandbox \
    && chmod 0755 /out/grain

# ==============================================================================
# Stage 1: Minimal base guest rootfs (kept in sync with Granulefile.guest-base)
# ==============================================================================
FROM ${BASE_IMAGE} AS guest_base_rootfs

# Build-time apt network configuration
RUN printf 'Acquire::ForceIPv4 "true";\nAcquire::Retries "3";\nAcquire::http::Timeout "60";\nAcquire::https::Timeout "60";\n' > /etc/apt/apt.conf.d/99-grain-build

# No suspend/resume device, so the initramfs must not wait for one.
#
# initramfs-tools' scripts/local-premount/resume waits for the device named
# by RESUME= and eventually gives up ("Gave up waiting for suspend/resume
# device" on the guest console). Without this file, initramfs-tools infers a
# RESUME device at build time, the guest -- which has no swap and no
# hibernation image -- never sees it appear, and every boot pays ~105
# seconds for the wait: that is the whole of the gap between
# "virtio_blk virtio0: [vda]" and "EXT4-fs (vda): mounted filesystem" that
# put the login prompt at ~122s against GranuleConfig.readyTimeout's
# hard-coded two minutes, and so cost 254 sandbox creations in a day. A
# guest here is booted fresh from a packed image every time and never
# hibernates, so there is never a resume to do.
#
# It is written before any package is installed so that every initramfs
# this build generates carries it -- the guest kernel package's own, and the
# regeneration further down this file. The sandbox stage builds FROM this
# rootfs, so it inherits the file with everything else.
RUN install -d -m0755 /etc/initramfs-tools/conf.d \
    && echo 'RESUME=none' > /etc/initramfs-tools/conf.d/resume

# Stock Granule Debian VM base packages + Grain's minimal sandbox boundary
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd-sysv \
    udev \
    kmod \
    iproute2 \
    acpid \
    linux-image-$(dpkg --print-architecture) \
    klibc-utils \
    e2fsprogs \
    libnss-myhostname \
    sudo \
    git \
    curl \
    ca-certificates \
    python3-minimal \
    procps \
    findutils \
    grep \
    sed \
    gawk \
    tar \
    coreutils \
    && python3 -c 'import os, socket, sys, threading' \
    && systemctl enable acpid \
    && printf 'evdev\n' > /etc/modules-load.d/granule-evdev.conf \
    && rm -rf /var/lib/apt/lists/* /etc/apt/apt.conf.d/99-grain-build

COPY Granulefile* .grain-ca.cr[t] /tmp/
RUN if [ -f /tmp/.grain-ca.crt ]; then \
        cp /tmp/.grain-ca.crt /usr/local/share/ca-certificates/grain-ca.crt \
        && update-ca-certificates; \
    fi && rm -f /tmp/.grain-ca.crt /tmp/Granulefile*
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Hostname resolution and interface naming
RUN sed -i 's/^hosts:.*/hosts:          files myhostname dns/' /etc/nsswitch.conf \
    && install -d -m0755 /etc/systemd/network \
    && printf '[Match]\nType=ether\n\n[Link]\nNamePolicy=\nName=eth0\n' > /etc/systemd/network/00-eth0.link \
    && ln -sf /dev/null /etc/udev/rules.d/80-net-setup-link.rules \
    && update-initramfs -u -k all

# The "debian" account (uid 1000), /home/agent -> /home/debian symlink, sudo
# access, and kvm group for nested virtualization.
# Passwordless root for "debian" is deliberate: the boundary is the VM and
# the host firewall, not this account. Do not narrow or remove it without
# reading docs/granule-guest-root.md.
RUN useradd -m -u 1000 -s /bin/bash debian \
    && ln -s /home/debian /home/agent \
    && echo 'debian ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/90-debian \
    && chmod 0440 /etc/sudoers.d/90-debian \
    && install -d -m0700 -o debian -g debian /home/debian/.ssh \
    && (getent group kvm >/dev/null || groupadd --system kvm) \
    && usermod -aG kvm debian

# grain-connect forwarder (part of the base boundary so custom images FROM
# guest-base do not need a Go toolchain)
COPY --from=grain_connect_builder /out/grain-connect /usr/local/bin/grain-connect
RUN chmod 0755 /usr/local/bin/grain-connect \
    && install -d -m0755 /usr/lib/tmpfiles.d \
    && printf 'd /run/grain 0755 root root -\n' > /usr/lib/tmpfiles.d/grain.conf

# grain, for `grain host-script <name>` (pkg/hostscriptcli). A grant
# installs a shell stand-in instead where an image has none.
COPY --from=grain_connect_builder /out/grain /usr/local/bin/grain
RUN chmod 0755 /usr/local/bin/grain

# grain-growfs: resize root filesystem to fill virtual disk on boot
RUN printf '#!/bin/sh\nset -u\nroot_dev=$(findmnt -n -o SOURCE / 2>/dev/null || true)\ncase "${root_dev}" in\n  /dev/*) ;;\n  *) echo "grain-growfs: root is ${root_dev:-unknown}, not a block device -- nothing to grow"; exit 0 ;;\nesac\nif ! resize2fs "${root_dev}"; then\n  echo "grain-growfs: resize2fs ${root_dev} failed -- continuing with the filesystem as it is" >&2\nfi\nexit 0\n' > /usr/local/sbin/grain-growfs \
    && chmod 0755 /usr/local/sbin/grain-growfs

RUN printf '[Unit]\nDescription=Grow the root filesystem onto the whole virtual disk (grain sandbox)\nDefaultDependencies=no\nAfter=systemd-remount-fs.service\nBefore=sysinit.target\nConditionPathIsReadWrite=/\n\n[Service]\nType=oneshot\nExecStart=/usr/local/sbin/grain-growfs\nRemainAfterExit=yes\nStandardOutput=journal+console\nStandardError=journal+console\n\n[Install]\nWantedBy=sysinit.target\n' > /etc/systemd/system/grain-growfs.service \
    && ln -sf /etc/systemd/system/grain-growfs.service /etc/systemd/system/sysinit.target.wants/grain-growfs.service

# Mount /tmp on tmpfs so go test link outputs (/tmp/go-build*) and
# t.TempDir() SQLite databases stay in RAM instead of hitting /dev/vda
# (ext4 over nested virtio-blk).
RUN echo 'tmpfs /tmp tmpfs mode=1777,strictatime,nosuid,nodev,size=50% 0 0' >> /etc/fstab

# Stamp the Grain sandbox contract version (pkg/sandboximage.Contract).
RUN install -d -m0755 /etc/grain \
    && printf '1\n' > /etc/grain/sandbox-contract
LABEL dev.grain.sandbox.contract="1"

# Base VM pack target
VM PACK --variant=debian AS guest_base
LABEL dev.grain.sandbox.contract="1"

# ==============================================================================
# Stage 2: Development toolchains & container runtime
# ==============================================================================
FROM guest_base_rootfs AS sandbox_rootfs
ARG GO_VERSION
ARG NODE_VERSION
ARG KIND_VERSION
ARG ACT_VERSION
ARG ACTIONLINT_VERSION

ARG GO_VERSION=1.26.10
ARG NODE_VERSION=20.19.0
ARG KIND_VERSION=v0.32.0
ARG ACT_VERSION=v0.2.89
ARG ACTIONLINT_VERSION=1.7.12
# One checksum per architecture, because a checksum is of a particular
# tarball and this image is built for whichever architecture its host runs.
# A single pin meant an arm64 build downloaded the arm64 archive and then
# failed comparing it against amd64's digest. The version above is shared on
# purpose -- the same convention Dockerfile uses for KUBECTL and the agent
# CLIs -- so that a bump of one architecture is a bump of both and two builds
# of one grain commit cannot carry different toolchains.
ARG ACTIONLINT_SHA256_AMD64=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ARG ACTIONLINT_SHA256_ARM64=325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6
# Checksums of the release archives the versions above name, from the
# publishers' own sha256 lists: TLS proves who served the bytes, these prove
# they are the release. Bump them with the version.
ARG GO_SHA256_AMD64=ccfe7ae822d2c2f41f4fe7c956199967a4dac22d0ee0d2b2bfdb440aab3b20c5
ARG GO_SHA256_ARM64=3f4227ce7b206a513e794f1393adb473a07b46e94d18bd15d1c684bbb7319797
ARG NODE_SHA256_AMD64=b4e336584d62abefad31baecff7af167268be9bb7dd11f1297112e6eed3ca0d5
ARG NODE_SHA256_ARM64=dbe339e55eb393955a213e6b872066880bb9feceaa494f4d44c7aac205ec2ab9
ARG PLAYWRIGHT_VERSION=1.62.1

COPY Granulefile* .grain-ca.cr[t] /tmp/
RUN if [ -f /tmp/.grain-ca.crt ]; then \
        cp /tmp/.grain-ca.crt /usr/local/share/ca-certificates/grain-ca.crt \
        && update-ca-certificates; \
    fi && rm -f /tmp/.grain-ca.crt /tmp/Granulefile*
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Build-time apt network configuration
RUN printf 'Acquire::ForceIPv4 "true";\nAcquire::Retries "3";\nAcquire::http::Timeout "60";\nAcquire::https::Timeout "60";\n' > /etc/apt/apt.conf.d/99-grain-build

# Developer convenience packages, Python, and OCR/attachment tools (layered on
# top of the minimal guest-base boundary for the default full sandbox guest)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    python3-venv \
    pipx \
    jq \
    ripgrep \
    fd-find \
    shellcheck \
    file \
    openssh-client \
    tmux \
    unzip \
    xz-utils \
    bubblewrap \
    gnupg \
    tesseract-ocr \
    tesseract-ocr-eng \
    imagemagick \
    poppler-utils \
    fonts-urw-base35 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Docker daemon configuration and installation
RUN install -m 0755 -d /etc/apt/keyrings /etc/docker /usr/local/libexec /etc/systemd/system/docker.service.d \
    && printf '{\n  "bip": "10.240.0.1/24",\n  "default-address-pools": [\n    {\n      "base": "10.241.0.0/16",\n      "size": 24\n    }\n  ],\n  "mtu": 1460\n}\n' > /etc/docker/daemon.json \
    && printf '#!/bin/sh\nset -eu\nmtu=""\nif [ -r /sys/class/net/eth0/mtu ]; then\n  mtu=$(cat /sys/class/net/eth0/mtu 2>/dev/null || true)\nfi\nif [ -z "$mtu" ] || [ "$mtu" -le 0 ] 2>/dev/null; then\n  mtu=$(sed -n '\''s/.*\\bgranule\\.mtu=\\([0-9]*\\).*/\\1/p'\'' /proc/cmdline 2>/dev/null || true)\nfi\nif [ -z "$mtu" ] || [ "$mtu" -le 0 ] 2>/dev/null; then\n  def_iface=$(ip route show default 2>/dev/null | awk '\''{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}'\'' | head -n1 || true)\n  if [ -n "$def_iface" ] && [ -r "/sys/class/net/$def_iface/mtu" ]; then\n    mtu=$(cat "/sys/class/net/$def_iface/mtu" 2>/dev/null || true)\n  fi\nfi\nif [ -n "$mtu" ] && [ "$mtu" -ge 576 ] 2>/dev/null && [ "$mtu" -le 65535 ] 2>/dev/null; then\n  daemon_json="/etc/docker/daemon.json"\n  mkdir -p /etc/docker\n  if [ -f "$daemon_json" ] && [ -s "$daemon_json" ]; then\n    tmp=$(mktemp /etc/docker/daemon.json.tmp.XXXXXX 2>/dev/null || mktemp /tmp/daemon.json.tmp.XXXXXX)\n    if command -v jq >/dev/null 2>&1 && jq --argjson mtu "$mtu" '\''.mtu = $mtu'\'' "$daemon_json" > "$tmp" 2>/dev/null; then\n      mv -f "$tmp" "$daemon_json"\n      chmod 0644 "$daemon_json"\n    elif command -v python3 >/dev/null 2>&1; then\n      rm -f "$tmp"\n      python3 -c "import json, sys; d = json.load(open('\''$daemon_json'\'')) if open('\''$daemon_json'\'').read().strip() else {}; d['\''mtu'\''] = int(sys.argv[1]); json.dump(d, open('\''$daemon_json'\'', '\''w'\''), indent=2)" "$mtu" 2>/dev/null || true\n    else\n      rm -f "$tmp"\n    fi\n  else\n    printf '\''{\\n  "bip": "10.240.0.1/24",\\n  "default-address-pools": [\\n    {\\n      "base": "10.241.0.0/16",\\n      "size": 24\\n    }\\n  ],\\n  "mtu": %d\\n}\\n'\'' "$mtu" > "$daemon_json"\n    chmod 0644 "$daemon_json"\n  fi\nfi\nexit 0\n' > /usr/local/libexec/docker-configure-mtu \
    && chmod 0755 /usr/local/libexec/docker-configure-mtu \
    && printf '[Service]\nExecStartPre=/usr/local/libexec/docker-configure-mtu\n' > /etc/systemd/system/docker.service.d/10-mtu.conf
RUN curl -4 -fsSL --max-time 60 --retry 3 https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        docker-ce \
        docker-ce-cli \
        containerd.io \
        docker-buildx-plugin \
        docker-compose-plugin \
    && usermod -aG docker debian \
    && systemctl enable docker \
    && rm -rf /var/lib/apt/lists/*

# Kind binary and inotify limits
RUN curl -4 -fsSL --max-time 120 --retry 3 "https://kind.sigs.k8s.io/dl/${KIND_VERSION}/kind-linux-$(dpkg --print-architecture)" -o /usr/local/bin/kind \
    && chmod 0755 /usr/local/bin/kind \
    && printf 'fs.inotify.max_user_watches = 524288\nfs.inotify.max_user_instances = 8192\n' > /etc/sysctl.d/99-grain-kind.conf

# Cloud SDKs, Terraform, and Kubectl
RUN curl -4 -fsSL --max-time 60 --retry 3 https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && curl -4 -fsSL --max-time 60 --retry 3 https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com bookworm main" > /etc/apt/sources.list.d/hashicorp.list \
    && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 update \
    && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 install -y --no-install-recommends \
        google-cloud-cli \
        terraform \
        google-cloud-cli-gke-gcloud-auth-plugin \
        kubectl \
    && rm -rf /var/lib/apt/lists/*

# Go toolchain
RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
        amd64) sha="${GO_SHA256_AMD64}" ;; \
        arm64) sha="${GO_SHA256_ARM64}" ;; \
        *) echo "no pinned go checksum for $arch" >&2; exit 1 ;; \
       esac \
    && curl -4 -fsSL --max-time 180 --retry 3 "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz" -o /tmp/go.tar.gz \
    && echo "${sha}  /tmp/go.tar.gz" | sha256sum -c - \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm -f /tmp/go.tar.gz \
    && ln -sf /usr/local/go/bin/go /usr/local/bin/go \
    && ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt \
    && install -d -m0755 -o debian -g debian /home/debian/.config/go \
    && GOENV=/home/debian/.config/go/env /usr/local/go/bin/go env -w GOTOOLCHAIN=local

# Node.js toolchain and Playwright-compatible npm wrapper
RUN mkdir -p /usr/local/lib/nodejs \
    && arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
        amd64) node_arch=x64; sha="${NODE_SHA256_AMD64}" ;; \
        arm64) node_arch=arm64; sha="${NODE_SHA256_ARM64}" ;; \
        *) echo "no pinned node checksum for $arch" >&2; exit 1 ;; \
       esac \
    && curl -4 -fsSL --max-time 180 --retry 3 "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" -o /tmp/node.tar.xz \
    && echo "${sha}  /tmp/node.tar.xz" | sha256sum -c - \
    && tar -C /usr/local/lib/nodejs --strip-components=1 -xJf /tmp/node.tar.xz \
    && rm -f /tmp/node.tar.xz \
    && ln -sf /usr/local/lib/nodejs/bin/node /usr/local/bin/node \
    && ln -sf /usr/local/lib/nodejs/bin/npx /usr/local/bin/npx \
    && printf '#!/bin/sh\nexport PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD="${PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD-1}"\nexec /usr/local/lib/nodejs/bin/npm "$@"\n' > /usr/local/bin/npm \
    && chmod 0755 /usr/local/bin/npm \
    && HOME=/home/debian npm config set prefer-offline=true --location=global \
    && HOME=/home/debian npm config set audit=false --location=global \
    && HOME=/home/debian npm config set fund=false --location=global \
    && HOME=/home/debian npm config set fetch-retries=5 --location=global \
    && HOME=/home/debian npm config set fetch-retry-mintimeout=10000 --location=global \
    && HOME=/home/debian npm config set fetch-retry-maxtimeout=120000 --location=global \
    && HOME=/home/debian npm config set cafile=/etc/ssl/certs/ca-certificates.crt --location=global \
    && npm config set cafile=/etc/ssl/certs/ca-certificates.crt --location=global

# Pre-install and cache Playwright browser binaries
ENV PLAYWRIGHT_BROWSERS_PATH=/var/cache/playwright
RUN mkdir -p /var/cache/playwright \
    && PLAYWRIGHT_BROWSERS_PATH=/var/cache/playwright npx --yes playwright-core@${PLAYWRIGHT_VERSION} install --with-deps chromium webkit \
    && chmod -R 777 /var/cache/playwright

# act (GitHub Actions local runner)
RUN curl -4 -fsSL --max-time 120 --retry 3 "https://github.com/nektos/act/releases/download/${ACT_VERSION}/act_Linux_$(case "$(dpkg --print-architecture)" in amd64) echo x86_64 ;; arm64) echo arm64 ;; esac).tar.gz" -o /tmp/act.tar.gz \
    && tar -C /usr/local/bin -xzf /tmp/act.tar.gz act \
    && rm -f /tmp/act.tar.gz \
    && chmod 0755 /usr/local/bin/act

# actionlint (GitHub Actions workflow linter)
RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
        amd64) sha="${ACTIONLINT_SHA256_AMD64}" ;; \
        arm64) sha="${ACTIONLINT_SHA256_ARM64}" ;; \
        *) echo "no pinned actionlint checksum for $arch" >&2; exit 1 ;; \
       esac \
    && curl -4 -fsSL --max-time 120 --retry 3 "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_${arch}.tar.gz" -o /tmp/actionlint.tar.gz \
    && echo "${sha}  /tmp/actionlint.tar.gz" | sha256sum -c - \
    && tar -C /usr/local/bin -xzf /tmp/actionlint.tar.gz actionlint \
    && rm -f /tmp/actionlint.tar.gz \
    && chmod 0755 /usr/local/bin/actionlint

# In-guest documentation
RUN mkdir -p /etc/granule-guest \
    && printf 'This is a grain sandbox guest: a bwsalmon/granule guest image provisioned\nwith toolchains and daemons for Grain task runs.\n\nToolchains & daemons:\n  - Go (/usr/local/go/bin/go, /usr/local/bin/go)\n  - Node.js (/usr/local/lib/nodejs/bin/node, /usr/local/bin/node, npm, npx)\n  - Docker (docker-ce, containerd, docker-buildx-plugin, docker-compose-plugin)\n  - Kubernetes (kind, kubectl)\n  - Google Cloud SDK (google-cloud-cli, google-cloud-cli-gke-gcloud-auth-plugin)\n  - Terraform (/usr/bin/terraform)\n  - act (/usr/local/bin/act)\n  - actionlint (/usr/local/bin/actionlint)\n  - Playwright browser cache (/var/cache/playwright)\n  - OCR tools (tesseract-ocr, imagemagick, poppler-utils, fonts-urw-base35, fonts-dejavu-core)\n  - Forwarder (/usr/local/bin/grain-connect)\n  - grain host-script (/usr/local/bin/grain)\n' > /etc/granule-guest/README

# Clean up apt caches and set debian home permissions
RUN chown -R debian:debian /home/debian \
    && rm -rf /var/lib/apt/lists/* /etc/apt/apt.conf.d/99-grain-build /tmp/*

# Pack the final sandbox guest into a bootable VM image
VM PACK --variant=debian AS sandbox_guest
VM SET memory-mb=4096 cpus=4
LABEL dev.grain.sandbox.contract="1"
