# Example configuration file for `scripts/deploy-gke.sh --config deploy/gke/deploy-gke.env`
GRAIN_GKE_PROJECT="my-gcp-project"
GRAIN_GKE_REGION="us-central1"
GRAIN_GKE_ZONE="us-central1-a"
GRAIN_GKE_CLUSTER="grain-gke"
GRAIN_GKE_ADOPT_CLUSTER="false"
GRAIN_GKE_NAMESPACE="grain"
GRAIN_GKE_DNS_NAME="grain.example.com"
GRAIN_GKE_DNS_ZONE=""
GRAIN_GKE_IAP_PRINCIPALS="user:operator@example.com"
GRAIN_GKE_IMAGE="ghcr.io/bwsalmon/grain/grain:main"
GRAIN_GKE_SANDBOX_IMAGE="ghcr.io/bwsalmon/grain/granule:latest"
GRAIN_GKE_POSTGRES="cloudsql"
GRAIN_GKE_CLOUDSQL_INSTANCE="grain-postgres"
GRAIN_GKE_CLOUDSQL_TIER="db-custom-2-8192"
GRAIN_GKE_TARGET_REPO="ai-on-gke/grain"
GRAIN_GKE_HOSTD_NAME="cloudtop"
GRAIN_GKE_HOSTD_OWNER="operator"
GRAIN_GKE_DATA_DIR="/var/lib/grain/data"
GRAIN_GKE_ACCESS_MODE="dialout"
