#!/bin/sh
# Give this guest the IPv6 half of the identity it took over from the
# sandbox's interface.
#
# The IPv4 half arrives on the kernel's own "ip=" parameter, which the
# bundled kernel acts on before userspace starts. Nothing equivalent
# exists for IPv6, so "granule run" passes it as a parameter of its own,
#
#   granule.ip6=2001:db8:1::5/64,fe80::42:acff:fe11:5
#
# -- the global address with its prefix length, then the link-local
# address the pod had -- and this installs both. The routes that go with
# them are granule.routes6=, which granule-configure-routes installs after
# this has run. See pkg/netshim's GuestConfig for the deriving end, and
# docs/ipv6-dual-stack-design.md (section 3.3) for the design.
#
# A guest booted without that parameter -- an IPv4-only sandbox, no
# netshim in front of it, or an operator's own "ip=" or "granule.ip6=",
# which netshim leaves alone -- has nothing to do here and exits
# successfully, as does a guest whose kernel has no IPv6: its IPv4 half
# still has to come up, so that is a line on the console, not a failure.
set -eu

CMDLINE="${GRANULE_CMDLINE_FILE:-/proc/cmdline}"
IF_INET6="${GRANULE_IF_INET6:-/proc/net/if_inet6}"
SYSCTL_DIR="${GRANULE_SYSCTL_DIR:-/proc/sys}"

# One parameter per line; see granule-configure-routes for why.
param() {
	tr ' ' '\n' < "${CMDLINE}" | sed -n "s/^$1=//p" | tail -1
}

spec=$(param 'granule\.ip6')
[ -n "${spec}" ] || exit 0

global="${spec%%,*}"
linklocal=""
case "${spec}" in
*,*) linklocal="${spec#*,}" ;;
esac

# Field 6 of ip=, as granule-configure-routes reads it, or eth0 for a
# v6-only guest, which has no ip= at all.
ipparam=$(param 'ip')
dev=$(printf '%s' "${ipparam}" | cut -d: -f6)
dev="${GRANULE_NET_IFACE:-${dev:-eth0}}"

if [ ! -e "${IF_INET6}" ]; then
	echo "granule-configure-ip6: this guest's kernel has no IPv6, so it cannot take over ${global}; it has the sandbox's IPv4 identity only, if it has one" >&2
	exit 0
fi

# Wait for the interface, for the reason granule-configure-routes does: a
# command line carrying granule.ip6= is one netshim built, so there is a
# NIC coming, and nothing reruns this.
timeout="${GRANULE_NET_DEVICE_TIMEOUT:-60}"
waited=0
until ip link show dev "${dev}" >/dev/null 2>&1; do
	if [ "${waited}" -ge "${timeout}" ]; then
		echo "granule-configure-ip6: no ${dev} to configure after ${timeout}s; this guest has no IPv6 address" >&2
		exit 1
	fi
	sleep 1
	waited=$((waited + 1))
done

# The guest's IPv6 table is exactly the carried one, as its IPv4 table
# is. A router advertisement from anyone else on a shared segment must
# not install a default route or a SLAAC address -- an address the
# splice's guard would drop anyway -- and a privacy address is one too.
for knob in accept_ra=0 autoconf=0 use_tempaddr=0; do
	name="${knob%%=*}"
	path="${SYSCTL_DIR}/net/ipv6/conf/${dev}/${name}"
	if ! printf '%s\n' "${knob#*=}" > "${path}"; then
		echo "granule-configure-ip6: could not set ${name} on ${dev}" >&2
	fi
done

failed=0

# No link-local address of the kernel's own invention: the guest holds
# the pod's, verbatim, because that is the one the guard lets through and
# the one a point-to-point CNI's host side already has in its neighbour
# cache. addrgenmode only stops the next one being generated, and on the
# bundled kernel "ip=" has usually brought the link up already, so any
# address generated by then is flushed too.
if ! ip link set dev "${dev}" addrgenmode none; then
	echo "granule-configure-ip6: could not stop ${dev} generating its own link-local address" >&2
	failed=1
fi
ip -6 addr flush dev "${dev}" scope link || true

# nodad: the runtime's IPAM, not the segment, is what guarantees these
# are unique, and the namespace's own copy is invisible behind the splice.
# Duplicate address detection could only delay the address by a second,
# or -- with a hairpinned bridge port echoing the guest's own probe back
# at it -- fail it for good.
if [ -n "${linklocal}" ]; then
	if ! ip -6 addr replace "${linklocal}/64" dev "${dev}" nodad; then
		echo "granule-configure-ip6: could not add ${linklocal}/64 to ${dev}" >&2
		failed=1
	fi
fi
# noprefixroute, when granule.routes6= says what is on-link: otherwise the
# address installs its own on-link route for the whole prefix, at the
# kernel's metric 256, which the carried route for that same prefix
# (metric 1024) can neither replace nor outrank -- and the prune keeps it,
# since the prefix is one the container has. On a point-to-point CNI
# (kindnet, Cilium), where the container reaches its own prefix through a
# gateway, that leaves the guest soliciting neighbours that never answer,
# and every other pod unreachable over IPv6. The container's own on-link
# route, where it has one (docker's bridge), is among the carried routes.
# IPv4 has no such problem: "route replace" takes over the kernel's route.
prefixroute=""
[ -z "$(param 'granule\.routes6')" ] || prefixroute="noprefixroute"
# shellcheck disable=SC2086
if ! ip -6 addr replace "${global}" dev "${dev}" nodad ${prefixroute}; then
	echo "granule-configure-ip6: could not add ${global} to ${dev}" >&2
	failed=1
fi

# Up last, if "ip=" has not already done it: a v6-only guest has no
# "ip=", and nothing else brings its interface up.
if ! ip link set dev "${dev}" up; then
	echo "granule-configure-ip6: could not bring ${dev} up" >&2
	failed=1
fi

exit "${failed}"
