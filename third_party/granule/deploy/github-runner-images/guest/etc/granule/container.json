{
  "name": "actions-runner",
  "rootfs": "/",
  "entrypoint": [
    "/usr/local/libexec/granule-actions-runner"
  ],
  "env": [
    "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "HOME=/home/runner",
    "USER=runner",
    "LOGNAME=runner",
    "SHELL=/bin/bash",
    "RUNNER_MANUALLY_TRAP_SIG=1"
  ],
  "working_dir": "/home/runner/actions-runner",
  "user": "runner",
  "haltOnExit": true
}
