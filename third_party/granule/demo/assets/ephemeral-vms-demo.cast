{"version": 2, "width": 110, "height": 36, "timestamp": 1789971070, "env": {"SHELL": "/bin/bash", "TERM": "dumb"}}
[0.006635, "o", "\u001b[1m========================================================================\u001b[0m\r\n\u001b[0;32m\u001b[1m   GRANULE DEMO: Multi-VM Pods & Ephemeral MicroVM Containers in K8s   \u001b[0m\r\n\u001b[1m========================================================================\u001b[0m\r\n"]
[0.007579, "o", "\r\n\u001b[1;33mDemonstrating multiple hardware-isolated Cloud-Hypervisor microVMs\u001b[0m\r\n\u001b[1;33mrunning inside a SINGLE Kubernetes Pod with sub-second ephemeral containers.\u001b[0m\r\n\r\n"]
[1.508966, "o", "\u001b[1m--- Step 1: Environment & Cluster Verification ---\u001b[0m\r\n\u001b[0;36m$ \u001b[1mkubectl get nodes -o wide\u001b[0m\r\n"]
[2.419673, "o", "NAME                         STATUS   ROLES           AGE     VERSION   INTERNAL-IP   EXTERNAL-IP   OS-IMAGE                       KERNEL-VERSION           CONTAINER-RUNTIME\r\ngranule-demo-control-plane   Ready    control-plane   2m50s   v1.36.1   172.31.0.2    <none>        Debian GNU/Linux 13 (trixie)   6.1.0-50-amd64 (amd64)   containerd://2.3.1\r\n"]
[2.421525, "o", "\r\n\u001b[0;36m$ \u001b[1mls -la /dev/kvm\u001b[0m\r\n"]
[3.22553, "o", "crw-rw---- 1 root 994 10, 232 Sep 21 06:10 /dev/kvm\r\n"]
[3.225781, "o", "\r\n"]
[4.72759, "o", "\u001b[1m--- Step 2: Provisioning Multi-VM Base Pod (web + builder) ---\u001b[0m\r\n\u001b[0;36m$ \u001b[1mkubectl apply -f demo/assets/pod-multi-vm.yaml\u001b[0m\r\n"]
[27.05952, "o", "pod/granule-multi-vm created\r\n"]
[27.062331, "o", "\r\n\u001b[0;36m$ \u001b[1mkubectl wait --for=condition=Ready pod/granule-multi-vm --timeout=30s\u001b[0m\r\n"]
[33.425208, "o", "pod/granule-multi-vm condition met\r\n"]
[33.427038, "o", "\r\n\u001b[0;36m$ \u001b[1mkubectl get pod granule-multi-vm -o wide\u001b[0m\r\n"]
[34.366621, "o", "NAME               READY   STATUS    RESTARTS   AGE   IP           NODE                         NOMINATED NODE   READINESS GATES\r\ngranule-multi-vm   3/3     Running   0          7s    10.244.0.7   granule-demo-control-plane   "]
[34.366687, "o", "<none>           <none>\r\n"]
[34.369425, "o", "\r\n"]
[35.871893, "o", "\u001b[1m--- Step 3: Inspecting Regular VM Containers (web & builder) ---\u001b[0m\r\n\u001b[0;36m$ \u001b[1mkubectl exec granule-multi-vm -c web -- granule exec -- uname -a\u001b[0m\r\n"]
[36.896796, "o", "Linux debuerreotype 6.16.9+ #3 SMP Fri May  8 13:58:25 UTC 2026 x86_64 GNU/Linux\r\n"]
[36.905605, "o", "\r\n\u001b[0;36m$ \u001b[1mkubectl exec granule-multi-vm -c builder -- granule exec -- uname -a\u001b[0m\r\n"]
[37.95173, "o", "Linux debuerreotype 6.16.9+ #3 SMP Fri May  8 13:58:25 UTC 2026 x86_64 GNU/Linux\r\n"]
[37.963387, "o", "\r\n"]
[39.46548, "o", "\u001b[1m--- Step 4: Injecting Ephemeral MicroVM Containers into Running Pod ---\u001b[0m\r\n"]
[39.465545, "o", "\r\n\u001b[1;33m>>> Injecting Ephemeral VM #1 (vm-ephemeral-1)...\u001b[0m\r\n"]
[39.46784, "o", "\u001b[0;36m$ \u001b[1mkubectl debug granule-multi-vm --image=granule:snapshot -c vm-ephemeral-1 --profile=sysadmin --custom demo/assets/ephemeral-vm.yaml\u001b[0m\r\n"]
[40.492234, "o", "\u001b[0;36m$ \u001b[1mkubectl wait --for=jsonpath='{.status.ephemeralContainerStatuses[?(@.name==\"vm-ephemeral-1\")].state.running.startedAt}' pod/granule-multi-vm\u001b[0m"]
[40.492478, "o", "\r\n"]
[42.753103, "o", "pod/granule-multi-vm condition met\r\n"]
[42.758047, "o", "\u001b[0;36m$ \u001b[1mkubectl exec granule-multi-vm -c vm-ephemeral-1 -- granule ready -timeout 10s\u001b[0m\r\n"]
[44.113144, "o", "\u001b[0;36m$ \u001b[1mkubectl exec granule-multi-vm -c vm-ephemeral-1 -- granule exec -- echo 'Hello World from vm-ephemeral-1!'\u001b[0m\r\n"]
[45.123028, "o", "Hello World from vm-ephemeral-1!"]
[45.12321, "o", "\r\n"]
[45.137523, "o", "\u001b[0;32m✓ vm-ephemeral-1 initialized in 4645ms (End-to-End Hello World: 5669ms)\u001b[0m\r\n"]
[46.139783, "o", "\r\n\u001b[1;33m>>> Injecting Ephemeral VM #2 (vm-ephemeral-2)...\u001b[0m\r\n"]
[46.141757, "o", "\u001b[0;36m$ \u001b[1mkubectl debug granule-multi-vm --image=granule:snapshot -c vm-ephemeral-2 --profile=sysadmin --custom demo/assets/ephemeral-vm.yaml\u001b[0m\r\n"]
[47.075949, "o", "\u001b[0;36m$ \u001b[1mkubectl wait --for=jsonpath='{.status.ephemeralContainerStatuses[?(@.name==\"vm-ephemeral-2\")].state.running.startedAt}' pod/granule-multi-vm\u001b[0m\r\n"]
[48.237782, "o", "pod/granule-multi-vm condition met\r\n"]
[49.098258, "o", "\u001b[0;36m$ \u001b[1mkubectl exec granule-multi-vm -c vm-ephemeral-2 -- granule ready -timeout 10s\u001b[0m\r\n"]
[50.424576, "o", "\u001b[0;36m$ \u001b[1mkubectl exec granule-multi-vm -c vm-ephemeral-2 -- granule exec -- echo 'Hello World from vm-ephemeral-2!'\u001b[0m\r\n"]
[51.531796, "o", "Hello World from vm-ephemeral-2!\r\n"]
[51.541664, "o", "\u001b[0;32m✓ vm-ephemeral-2 initialized in 4282ms (End-to-End Hello World: 5399ms)\u001b[0m\r\n"]
[52.543887, "o", "\r\n\u001b[1;33m>>> Injecting Ephemeral VM #3 (vm-ephemeral-3)...\u001b[0m\r\n"]
[52.54586, "o", "\u001b[0;36m$ \u001b[1mkubectl debug granule-multi-vm --image=granule:snapshot -c vm-ephemeral-3 --profile=sysadmin --custom demo/assets/ephemeral-vm.yaml\u001b[0m\r\n"]
[53.539043, "o", "\u001b[0;36m$ \u001b[1mkubectl wait --for=jsonpath='{.status.ephemeralContainerStatuses[?(@.name==\"vm-ephemeral-3\")].state.running.startedAt}' pod/granule-multi-vm\u001b[0m\r\n"]
[54.638633, "o", "pod/granule-multi-vm condition met\r\n"]
[54.642445, "o", "\u001b[0;36m$ \u001b[1mkubectl exec granule-multi-vm -c vm-ephemeral-3 -- granule ready -timeout 10s\u001b[0m\r\n"]
[56.101151, "o", "\u001b[0;36m$ \u001b[1mkubectl exec granule-multi-vm -c vm-ephemeral-3 -- granule exec -- echo 'Hello World from vm-ephemeral-3!'\u001b[0m\r\n"]
[57.145649, "o", "Hello World from vm-ephemeral-3!\r\n"]
[57.160345, "o", "\u001b[0;32m✓ vm-ephemeral-3 initialized in 3555ms (End-to-End Hello World: 4614ms)\u001b[0m\r\n"]
[58.16217, "o", "\r\n"]
[59.664169, "o", "\u001b[1m--- Step 5: Verifying Hardware Isolation Across All 5 VMs in Pod ---\u001b[0m\r\n\u001b[0;36m$ \u001b[1mUnique Linux Kernel Boot IDs across all Pod VM containers:\u001b[0m\r\n"]
[60.71577, "o", "  Container \u001b[1mweb\u001b[0m -> Kernel Boot ID: \u001b[0;32mfd09b725-bda0-4d3e-bf76-452d91ad4df8\u001b[0m\r\n"]
[60.940612, "o", "  Container \u001b[1mbuilder\u001b[0m -> Kernel Boot ID: \u001b[0;32mfd09b725-bda0-4d3e-bf76-452d91ad4df8\u001b[0m\r\n"]
[61.182394, "o", "  Container \u001b[1mvm-ephemeral-1\u001b[0m -> Kernel Boot ID: \u001b[0;32mfd09b725-bda0-4d3e-bf76-452d91ad4df8\u001b[0m\r\n"]
[61.454585, "o", "  Container \u001b[1mvm-ephemeral-2\u001b[0m -> Kernel Boot ID: \u001b[0;32mfd09b725-bda0-4d3e-bf76-452d91ad4df8\u001b[0m\r\n"]
[61.717898, "o", "  Container \u001b[1mvm-ephemeral-3\u001b[0m -> Kernel Boot ID: \u001b[0;32mfd09b725-bda0-4d3e-bf76-452d91ad4df8\u001b[0m"]
[61.718052, "o", "\r\n"]
