### reply cannot grant access
$ /home/debian/bin/grain reply 2 granted, go ahead
    grain: grain server: task 2 is parked on a config-change or access request, not a question: decide it on /tasks/2 (409 Conflict)
    -> exit=2
### the agent's token cannot grant its own access request
$ sh -c curl -s -w ' %{http_code}' -X POST -H 'Authorization: Bearer '$(cat /tmp/grain-life.ypUAqm/.config/grain/credentials/c) -H 'Content-Type: application/json' http://127.0.0.1:43569/api/tasks/2/access-request/grant -d '{}'; echo
    {"error":"POST /api/tasks/{id}/access-request/grant is not part of the agent API (docs/agent-api.md)"}
     403
    -> exit=0
    operator POST access-request/grant -> 200
### wait T1 (after the grant, the closing comment)
$ timeout 60 /home/debian/bin/grain wait 2 -until awaiting-reply
    2	awaiting_reply
      T1 done.
    -> exit=0
### show T1 (answered)
$ sh -c /home/debian/bin/grain show 2 | head -4
    2 T1 external loop
    state:      awaiting_reply
    reason:     awaiting_reply/answered [Reply]
    owner:      console-rest-e2e-operator
    -> exit=0
### operator closes T1 (access code)
$ env GRAIN_TOKEN=C0DE-TEST-CCCC-0000 /home/debian/bin/grain --server http://127.0.0.1:43569 close 2
    2 T1 external loop
    state:      closed
    reason:     closed/closed [Reopen]
    owner:      console-rest-e2e-operator
    repo:       acme/widgets
    reads:      acme/other
    priority:   5
    auto-merge: false
    
    external loop
    -> exit=0
### wait T1 closed
$ timeout 30 /home/debian/bin/grain wait 2
    2	closed	completed
      T1 done.
    -> exit=0
### T2 dispatches once T1 closed (its default scripted turn parks it answered)
$ timeout 90 /home/debian/bin/grain wait 3 -until closed,awaiting-reply
    3	awaiting_reply
      Scripted answer 1.
    -> exit=0
### show T2
$ sh -c /home/debian/bin/grain show 3 | head -5
    3 T2 waits on T1
    state:      awaiting_reply
    reason:     awaiting_reply/answered [Reply]
    owner:      console-rest-e2e-operator
    repo:       acme/widgets
    -> exit=0
### list -closed T1/T2
$ sh -c /home/debian/bin/grain list -closed | grep -E '^(2|3) '
    3      awaiting_reply  acme/widgets             T2 waits on T1
    2      closed          acme/widgets             T1 external loop
    -> exit=0
