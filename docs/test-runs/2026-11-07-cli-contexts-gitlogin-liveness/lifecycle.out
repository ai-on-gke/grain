== operator turns on externalAgentApi; the workstation mints a gma_ token
    PUT /api/config -> 200
### login --issue-token
$ env GRAIN_TOKEN=C0DE-TEST-CCCC-0000 /home/debian/bin/grain login http://127.0.0.1:43569 --name c --issue-token --expires 1d
    signed in to http://127.0.0.1:43569 as context c (external-token)
    -> exit=0
### whoami
$ /home/debian/bin/grain whoami
    context: c
    server: http://127.0.0.1:43569
    principal: agent:external:cli-debuerreotype-c-to5m8m
    owner: console-rest-e2e-operator
    scope set: grain/external-dev
    scopes: ci:read, ci:write, deployment:read, merge:write, repos:read, sandboxes:read, tasks:read, tasks:write, templates:read
    expires: 2026-11-08T22:53:10Z
    -> exit=0
== scripted turns for T1: ask_question, then request_secret, then request_access, then finish
    script-runs -> 204
== file T1, and T2 depending on it
### create without -repo (external caller)
$ /home/debian/bin/grain create -title no repo -body x
    grain: external:cli-debuerreotype-c-to5m8m has no calling task context: POST /api/tasks requires an explicit repo (or noRepo: true)
    -> exit=3
### create T1
$ /home/debian/bin/grain -json create -repo acme/widgets -title T1 external loop -body external loop
    {
      "id": "2",
      "title": "T1 external loop",
      "description": "external loop",
      "author": "external:cli-debuerreotype-c-to5m8m",
      "authorKind": "agent",
      "authorSource": "external-token",
      "authorLabel": "external agent cli-debuerreotype-c-to5m8m for console-rest-e2e-operator",
      "state": "proposed",
      "repo": "acme/widgets",
      "branch": "grain/task-2",
      "priority": 5,
      "autoMerge": false,
      "autoApproveProposals": false,
      "interactive": false,
      "admission": "standard",
      "hosting": "unattended",
      "owner": "console-rest-e2e-operator",
      "creator": "console-rest-e2e-operator",
      "capabilities": [],
      "createdAt": "2026-11-07T22:53:10.531035303Z",
      "blocked": false,
      "reason": {
        "reason": "proposed/unapproved",
        "class": "awaiting a person",
        "control": "Approve"
      }
    }
    -> exit=0
### create T2 -depends-on T1
$ /home/debian/bin/grain create -repo acme/widgets -title T2 waits on T1 -body after T1 -depends-on 2
    3 T2 waits on T1
    state:      proposed
    reason:     proposed/unapproved [Approve]
    owner:      console-rest-e2e-operator
    repo:       acme/widgets
    depends on: 2 (proposed)
    priority:   5
    auto-merge: false
    
    after T1
    -> exit=0
    T1=2 T2=3
### an agent cannot approve its own filing
$ /home/debian/bin/grain approve 3
    grain: external:cli-debuerreotype-c-to5m8m holds no api grant for scope tasks:admin, which POST /api/tasks/{id}/approve needs
    -> exit=3
### operator approves T1 (access code)
$ env GRAIN_TOKEN=C0DE-TEST-CCCC-0000 /home/debian/bin/grain --server http://127.0.0.1:43569 approve 2
    2 T1 external loop
    state:      queued
    reason:     queued/ready (a worker slot (max_workers) and a sandbox) [Run now]
    owner:      console-rest-e2e-operator
    repo:       acme/widgets
    priority:   5
    auto-merge: false
    
    external loop
    -> exit=0
### operator approves T2 (access code)
$ env GRAIN_TOKEN=C0DE-TEST-CCCC-0000 /home/debian/bin/grain --server http://127.0.0.1:43569 approve 3
    3 T2 waits on T1
    state:      queued
    reason:     queued/blocked_on_task (the task it depends on closing)
    owner:      console-rest-e2e-operator
    repo:       acme/widgets
    depends on: 2 (running)
    priority:   5
    auto-merge: false
    
    after T1
    -> exit=0
### list -json T2 blocked
$ sh -c /home/debian/bin/grain -json list | jq -c '.[] | select(.id=="3") | {id,state,dependsOn,blocked,reason,statusReason}'
    {"id":"3","state":"queued","dependsOn":["2"],"blocked":true,"reason":{"reason":"queued/blocked_on_task","class":"driven","resource":"the task it depends on closing","driver":"reconcileDispatch"},"statusReason":null}
    -> exit=0
### list shows the dependency
$ sh -c /home/debian/bin/grain list | grep -E '^(2|3) '
    2      running         acme/widgets             T1 external loop
    3      queued          acme/widgets             T2 waits on T1 (waits on 2)
    -> exit=0
### show T2 shows depends_on
$ sh -c /home/debian/bin/grain show 3 | head -20
    3 T2 waits on T1
    state:      queued
    reason:     queued/blocked_on_task (the task it depends on closing)
    owner:      console-rest-e2e-operator
    repo:       acme/widgets
    depends on: 2 (running)
    priority:   5
    auto-merge: false
    
    after T1
    filed by:        external agent cli-debuerreotype-c-to5m8m for console-rest-e2e-operator
    
    history:
      -> proposed        2026-11-07T22:53:10Z by external agent cli-debuerreotype-c-to5m8m for console-rest-e2e-operator
      -> queued          2026-11-07T22:53:10Z
    -> exit=0
### show T2 -json depends_on
$ sh -c /home/debian/bin/grain -json show 3 | jq -c '{id,state,dependsOn,depends_on,blockedBy}'
    {"id":"3","state":"queued","dependsOn":["2"],"depends_on":null,"blockedBy":["2"]}
    -> exit=0
### record.md for T2 (consolerestserver serves no namespace; see demo run)
$ sh -c /home/debian/bin/grain fs read task://3/record.md | head -30
    grain: the service is temporarily unavailable (ref 4ff1194e0438)
    -> exit=0
== T1 parks on ask_question; grain wait wakes on it
### wait T1 --until awaiting-reply
$ timeout 60 /home/debian/bin/grain wait 2 -until awaiting-reply
    2	awaiting_reply
      question: Should the retry budget be 3 or 5?
    -> exit=0
### show T1 liveness
$ sh -c /home/debian/bin/grain show 2 | head -12
    2 T1 external loop
    state:      awaiting_reply
    reason:     awaiting_reply/question [Reply]
    owner:      console-rest-e2e-operator
    repo:       acme/widgets
    priority:   5
    auto-merge: false
    
    external loop
    filed by:        external agent cli-debuerreotype-c-to5m8m for console-rest-e2e-operator
    suspended session: scripted-session-2 (antigravity, left by 2-1 at 2026-11-07T22:53:10Z)
                       this task's next run resumes it instead of starting from nothing
    -> exit=0
### inbox
