### list -json: stdout pure JSON, stderr one line
$ sh -c /home/debian/bin/grain --context narrow -json list 2>/tmp/grain-skill.wcaLRK/err.stale >/tmp/grain-skill.wcaLRK/out.stale; echo exit=$?; echo stderr-lines=$(wc -l </tmp/grain-skill.wcaLRK/err.stale); cat /tmp/grain-skill.wcaLRK/err.stale; jq -e 'type' /tmp/grain-skill.wcaLRK/out.stale
    exit=0
    stderr-lines=1
    note: grain skill for context narrow is stale; run 'grain skill install'
    "array"
    -> exit=0
### list (text): stderr notice, stdout untouched
$ sh -c /home/debian/bin/grain --context narrow list 2>/tmp/grain-skill.wcaLRK/err.text >/tmp/grain-skill.wcaLRK/out.text; cat /tmp/grain-skill.wcaLRK/err.text; grep -c 'stale' /tmp/grain-skill.wcaLRK/out.text
    1 closed not shown -- pass -closed to include them
    note: grain skill for context narrow is stale; run 'grain skill install'
    0
    -> exit=1
### the notice never names a token
$ sh -c grep -c -e gma_ -e '<access-code>' /tmp/grain-skill.wcaLRK/err.stale /tmp/grain-skill.wcaLRK/err.text
    /tmp/grain-skill.wcaLRK/err.stale:0
    /tmp/grain-skill.wcaLRK/err.text:0
    -> exit=1
    operator POST /api/templates (acme/secret) -> 201
   (waiting 60s for the token's rate-limit bucket to refill)
### re-install clears it
$ sh -c for a in claude codex gemini jetski; do /home/debian/bin/grain --context narrow skill install -project -$a -mcp >/dev/null; (cd /tmp/grain-skill.wcaLRK && /home/debian/bin/grain --context narrow skill install -$a -mcp >/dev/null); done; cd /tmp/grain-skill.wcaLRK && /home/debian/bin/grain --context narrow skill install -dir /tmp/grain-skill.wcaLRK/custom -mcp >/dev/null && /home/debian/bin/grain --context narrow skill install -project -dir /tmp/grain-skill.wcaLRK/proj/tools/grain -mcp >/dev/null && cd /tmp/grain-skill.wcaLRK/proj/sub && /home/debian/bin/grain --context narrow skill status -json | jq -c '{status, reasons}'
    {"status":"installed","reasons":null}
    -> exit=0
   (waiting 60s for the token's rate-limit bucket to refill)
