    Authorization: Bearer    0
    gma_                     0
    u5er:pa55                0
    pa55w0rd                 0
    <access-code> 0
    gma_<this-context-token> 0
### server field in config.json
$ sh -c jq -c '.contexts' /tmp/grain-skill.wcaLRK/home/.config/grain/config.json
    {"dev":{"server":"http://127.0.0.1:4301","auth":"external-token","credential":"file:dev","tokenId":"11"},"narrow":{"server":"http://127.0.0.1:4301","auth":"external-token","credential":"file:narrow","tokenId":"12"},"ui":{"server":"http://u5er:pa55w0rd@127.0.0.1:4301","auth":"external-token","credential":"file:ui","tokenId":"13"}}
    -> exit=0
== unscoped context: deployment-wide section
### skill install -dir (dev context)
$ /home/debian/bin/grain --context dev skill install -dir /tmp/grain-skill.wcaLRK/dev-skill
    installed	/tmp/grain-skill.wcaLRK/dev-skill/SKILL.md
    -> exit=0
### dev SKILL.md names both repos and templates
$ sh -c grep -c -e acme/secret -e secret-fix /tmp/grain-skill.wcaLRK/dev-skill/SKILL.md; grep -c PEXT-MARKER /tmp/grain-skill.wcaLRK/dev-skill/SKILL.md
    4
    0
    -> exit=1
   (waiting 60s for the token's rate-limit bucket to refill)
== status, mutation, staleness
### skill status -json (fresh)
$ sh -c /home/debian/bin/grain --context narrow skill status -json | jq -c '{status, reasons, files: [.files[] | {path, status, reasons}]}'
    {"status":"installed","reasons":null,"files":[{"path":"/tmp/grain-skill.wcaLRK/home/.claude/skills/grain/SKILL.md","status":"installed","reasons":null},{"path":"/tmp/grain-skill.wcaLRK/home/.codex/skills/grain/SKILL.md","status":"installed","reasons":null},{"path":"/tmp/grain-skill.wcaLRK/home/.gemini/skills/grain/SKILL.md","status":"installed","reasons":null},{"path":"/tmp/grain-skill.wcaLRK/home/.gemini/jetski/skills/grain/SKILL.md","status":"installed","reasons":null},{"path":"/tmp/grain-skill.wcaLRK/custom/SKILL.md","status":"installed","reasons":null},{"path":"/tmp/grain-skill.wcaLRK/proj/.claude/skills/grain/SKILL.md","status":"installed","reasons":null},{"path":"/tmp/grain-skill.wcaLRK/proj/.agents/skills/grain/SKILL.md","status":"installed","reasons":null},{"path":"/tmp/grain-skill.wcaLRK/proj/.gemini/skills/grain/SKILL.md","status":"installed","reasons":null},{"path":"/tmp/grain-skill.wcaLRK/proj/tools/grain/SKILL.md","status":"installed","reasons":null}]}
    -> exit=0
### list -json while fresh: stderr
$ sh -c /home/debian/bin/grain --context narrow -json list 2>/tmp/grain-skill.wcaLRK/err.fresh >/tmp/grain-skill.wcaLRK/out.fresh; echo exit=$?; wc -l </tmp/grain-skill.wcaLRK/err.fresh; jq -e type /tmp/grain-skill.wcaLRK/out.fresh
