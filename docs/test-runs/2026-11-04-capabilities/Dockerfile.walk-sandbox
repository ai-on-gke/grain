# grain-sbx:walk: the walk's sandbox image -- the sandbox contract (2),
# user debian, and the sandbox's own grain (cmd/grain-sandbox) copied in as
# ./grain. Dockerfile.k8s-sandbox's builder cannot fetch Go modules here.
# The base is pinned to the digest Dockerfile.k8s-sandbox's BASE_IMAGE
# uses, so a rebuild of this image pulls the same Debian it does rather
# than whatever the floating tag points at that day.
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates curl findutils git tar python3-minimal procps \
 && rm -rf /var/lib/apt/lists/* \
 && install -d -m0755 /etc/grain && printf '2\n' > /etc/grain/sandbox-contract \
 && useradd -m -u 1000 -s /bin/bash debian && ln -s /home/debian /home/agent
COPY grain /usr/local/bin/grain
USER debian
WORKDIR /home/debian
