# This directory is //go:embed'd by static.go, but its contents are
# generated by `npm run build` in the repository root's ui-registry/ (see its
# vite.config.js outDir) -- not checked in, so a stale build can never
# ship instead of a real one. .gitkeep and placeholder.html keep the
# directory present and non-empty on a fresh checkout before `make frontend`.
*
!.gitignore
!.gitkeep
!placeholder.html
