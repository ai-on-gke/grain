{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predicate",
    "expected_commit",
    "release_version",
    "policy_revision"
  ],
  "properties": {
    "predicate": {
      "enum": [
        "suite",
        "provenance",
        "soak",
        "person",
        "breaking_change",
        "signing_version",
        "publication_readiness"
      ]
    },
    "expected_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
