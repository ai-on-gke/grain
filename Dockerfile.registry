# Multi-stage build for the grain-registry container image.
#
# Build:  make image-registry                      (tags grain-registry:dev)
#         make image-registry IMAGE_REGISTRY=my/grain-registry:tag
# Run:    docker run --rm -p 8080:8080 -p 8081:8081 -p 8082:8082 \
#           grain-registry:dev -config /etc/grain/registry.yaml

ARG GO_VERSION=1.26.10
ARG GO_IMAGE=golang
ARG GO_IMAGE_DIGEST=sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af
ARG RUNTIME_IMAGE=debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

FROM ${GO_IMAGE}:${GO_VERSION}-bookworm@${GO_IMAGE_DIGEST} AS build

ENV GOTOOLCHAIN=local

COPY Dockerfile.registry .grain-ca.cr[t] /tmp/
RUN if [ -f /tmp/.grain-ca.crt ]; then \
        cp /tmp/.grain-ca.crt /usr/local/share/ca-certificates/grain-ca.crt && \
        update-ca-certificates; \
    fi && rm -f /tmp/.grain-ca.crt /tmp/Dockerfile.registry

WORKDIR /src
COPY . .

RUN git config --global --add safe.directory /src
ARG BUILDVCS=auto
ARG RELEASE=
ARG EDITION=
ARG MAIN_GRAIN_REGISTRY=./cmd/grain-registry
RUN set -eu; \
    vcs="$(./scripts/buildvcs.sh "${BUILDVCS}")"; \
    ldflags="-s -w"; \
    if [ -n "${RELEASE}" ]; then \
        ldflags="$ldflags -X github.com/ai-on-gke/grain/pkg/version.Release=${RELEASE}"; \
    fi; \
    if [ -n "${EDITION}" ]; then \
        ldflags="$ldflags -X github.com/ai-on-gke/grain/pkg/version.Edition=${EDITION}"; \
    fi; \
    CGO_ENABLED=0 go build -buildvcs="$vcs" -ldflags="$ldflags" -o /out/grain-registry "${MAIN_GRAIN_REGISTRY}"

FROM ${RUNTIME_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/bwsalmon/grain" \
      org.opencontainers.image.title="grain-registry" \
      org.opencontainers.image.description="The grain multi-instance registry, directory, and tunnel router."

RUN apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update && \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y --no-install-recommends \
        ca-certificates \
        tini && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 grain && \
    useradd --uid 1000 --gid 1000 --create-home --home-dir /var/lib/grain --shell /bin/bash grain

COPY --from=build /out/grain-registry /usr/local/bin/grain-registry

ARG GIT_REVISION=
ARG RELEASE=
LABEL org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.version="${RELEASE}"

USER grain
WORKDIR /var/lib/grain

EXPOSE 8080 8081 8082

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/grain-registry"]
